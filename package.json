{
  "name": "gh-vulpes-shapeup",
  "version": "2.0.0",
  "description": "Run Shape Up on GitHub Issues and Projects: a CLI for pitches, scopes, cooldowns and bugs, and an Action that runs the cycle's commands on the board.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shapeup": "bin/shapeup.mjs"
  },
  "exports": {
    "./config": "./src/config.mjs",
    "./domain": "./src/domain.mjs",
    "./github": "./src/github.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "board/",
    "config.schema.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vulpes-facility/gh-vulpes-shapeup.git"
  },
  "keywords": ["shape-up", "hill-chart", "github-projects", "github-actions"]
}
